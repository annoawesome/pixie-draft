{
  "compilerOptions": {
    "module": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist/",
    "rootDir": "./src/",

    "forceConsistentCasingInFileNames": true,

    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo/tsbuildinfo"
  },
  "exclude": ["src/public/", "test/"]
}
